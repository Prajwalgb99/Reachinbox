# ---- Server ----
PORT=4000
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
JWT_SECRET=change-me-too

# ---- Postgres ----
DATABASE_URL=postgres://reachinbox:reachinbox@localhost:5432/reachinbox

# ---- Redis (BullMQ + rate-limit counters) ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Elasticsearch ----
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# ---- Ethereal (fake SMTP) ----
# Leave blank to auto-generate a fresh Ethereal test account on boot (logged to console),
# or fill these in to pin a specific Ethereal account across restarts.
ETHEREAL_USER=
ETHEREAL_PASS=

# ---- Worker / rate limiting (all configurable, never hardcoded) ----
WORKER_CONCURRENCY=5
MIN_DELAY_MS_BETWEEN_SENDS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# ---- Google OAuth ----
# Create an OAuth Client (Web application) at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ---- Slack OAuth ----
# Create a Slack App at https://api.slack.com/apps -> OAuth & Permissions
# Scopes needed: chat:write, incoming-webhook
# Redirect URI: http://localhost:4000/api/slack/oauth/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/oauth/callback
